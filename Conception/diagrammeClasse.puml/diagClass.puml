@startuml CircuitVert
title "Diagramme de classes CircuitVert - Version Corrigée"
left to right direction

' Classe parent abstraite
abstract class Personne {
    -nom: string
    -email: string
    -password: string
}

' Classes utilisateurs
class Visiteur {
    +inscription()
    +seConnecter()
}

class Utilisateur {
    +ajouterFavoris()
    +modifierCompte()
    +rechercherFermier()
    +activeGeolocalisation()
    +contactAdmin()
}

class Fermier {
    +ajouterDesc()
    +supprimerDesc()
    +modifierDesc()
    +ajouterPhoto()
    +supprimerPhoto()
    +modifierPhoto()
    +ajouterHoraire()
    +supprimerHoraire()
    +modifierHoraire()
    +ajouterAdresse()
    +supprimerAdresse()
    +modifierAdresse()
    +ajouterPaiement()
    +supprimerPaiement()
    +modifierPaiement()
    +choixCatProduit()
}

class Admin {
    +supprimerUser()
    +modifierSite()
    +validerInscFarmier()
}

' Classe métier
class Description {
    -nomEntreprise: string
    -photo: string
    -horaire: int
    -adresse: string
    -moyenPaiement: string
}

' Relations d'héritage
Personne <|-- Visiteur
Personne <|-- Utilisateur
Utilisateur <|-- Fermier
Utilisateur <|-- Admin

' Association
Fermier "1" --> "*" Description : gère

@enduml
